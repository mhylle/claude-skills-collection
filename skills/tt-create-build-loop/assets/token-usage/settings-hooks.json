{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/token-usage.mjs\" --ingest --push-tasktracker --quiet",
            "timeout": 120
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/token-usage.mjs\" --ingest --push-tasktracker --quiet",
            "timeout": 120
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/token-usage.mjs\" --ingest --push-tasktracker --quiet",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
